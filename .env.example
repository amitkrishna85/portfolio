# Database Configuration (Neon Postgres)
# Pooled connection string for Prisma Client (queries)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection string without "-pooler" for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth / Auth.js Configuration
# Generate with: openssl rand -base64 32
AUTH_SECRET="industrial-twin-dev-super-secret-key-32chars"

# Admin User Credentials
ADMIN_EMAIL="director@industrial-twin.dev"
# Generate with: npm run hash-password (default below is: AdminIndustrial2025!)
# Note: Dollar signs must be escaped with \ (e.g. \$2a\$10\$) to prevent Next.js dotenv-expand from treating them as variables.
ADMIN_PASSWORD_HASH="\$2a\$10\$9H7b/JxYumQVDtD8aT/SweuG0XveUlnGAPewaF68WpuLRFwv1f5y."

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Integrations
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
CONTACT_NOTIFICATION_EMAIL="director@industrial-twin.dev"
ANTHROPIC_API_KEY=""
